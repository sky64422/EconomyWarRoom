{
  "name": "economy-war-room",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "run:exe": "node scripts/run-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "test": "npm run test:ui && cd src-tauri && cargo test --lib && cargo test --test integration_e2e --test risk_scenarios --test notch --test liquid_frames",
    "test:coverage": "bash scripts/coverage.sh",
    "test:ui": "node --experimental-strip-types --test tests/ui/*.test.mjs",
    "test:coverage:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/coverage-windows.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  }
}
